{{ 'mn-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mn-scripts.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
{%- assign v_actual = product.selected_or_first_available_variant -%}
{%- assign tonos = s.tonos | split: ',' -%}
{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ s.padding_top }}px; padding-bottom: {{ s.padding_bottom }}px; background-color: {{ s.color_fondo }}; color: {{ s.color_texto }}; }
{% endstyle %}
<section class="mn-section" data-mn-producto data-moneda="{{ cart.currency.iso_code }}">
  <div class="mn-container mn-pdp">

    <div class="mn-pdp__galeria">
      {%- if s.mostrar_visor -%}
        {%- assign color_inicial = '' -%}
        {%- for o in v_actual.options -%}
          {%- assign k = o | split: '·' | last | handleize -%}
          {%- for t in tonos -%}
            {%- assign tk = t | split: ':' | first | strip -%}
            {%- if tk == k -%}{%- assign color_inicial = k -%}{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if color_inicial == blank -%}{%- assign color_inicial = 'sand' -%}{%- endif -%}
        {%- assign tex = 'moreno-lienzo-COLOR.webp' | asset_url | replace: 'COLOR', '{c}' -%}
        {%- assign hmap = 'moreno-lienzo-COLOR-h.png' | asset_url | replace: 'COLOR', '{c}' -%}
        <div class="mn-pdp__visor mn-relieve mn-reveal">
          <div class="mn-360" data-moreno-360 data-tex="{{ tex }}" data-height="{{ hmap }}" data-color="{{ color_inicial }}">
            <div data-stage>
              <canvas aria-label="{{ product.title | escape }} en 3D. Arrastra para girar." role="img"></canvas>
              <div data-fallback hidden><div data-flip><img alt="Frente"><img alt="Espalda"></div></div>
            </div>
            {%- for t in tonos -%}
              {%- assign par = t | split: ':' -%}
              <button type="button" data-c="{{ par[0] | strip }}" hidden tabindex="-1" aria-hidden="true"></button>
            {%- endfor -%}
            <div class="mn-pdp__visor-ui mn-relieve" role="tablist" aria-label="Vista">
              <button type="button" role="tab" data-view="front" aria-selected="true">Frente</button>
              <button type="button" role="tab" data-view="side">Perfil</button>
              <button type="button" role="tab" data-view="back">Espalda</button>
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if product.media.size > 0 -%}
        <div class="mn-pdp__fotos">
          {%- for media in product.media limit: s.max_fotos -%}
            {%- if media.media_type == 'image' -%}
              <figure class="mn-pdp__foto mn-relieve mn-reveal" data-delay="{{ forloop.index | modulo: 4 }}">
                <img src="{{ media | image_url: width: 1100 }}" alt="{{ media.alt | default: product.title | escape }}"
                  {% if forloop.first and s.mostrar_visor == false %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}">
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif s.mostrar_visor == false -%}
        {%- assign frase = product.description | split: '</em>' | first | strip_html | strip -%}
        <div class="mn-pdp__foto mn-relieve" style="aspect-ratio: 4/5; display: grid;">
          <div class="mn-hundido" style="display:grid;place-items:center;padding:12%;text-align:center;font:italic 500 clamp(28px,3.4vw,46px)/1.15 var(--mn-marca);">“{{ frase | default: product.title }}”</div>
        </div>
      {%- endif -%}
    </div>

    <div class="mn-pdp__compra mn-relieve">
      {%- if s.etiqueta != blank -%}<p class="mn-etiqueta">{{ s.etiqueta }}</p>{%- endif -%}
      <h1 class="mn-display mn-pdp__titulo">{{ product.title }}</h1>
      <p class="mn-pdp__precio" data-mn-precio>{{ v_actual.price | money }} {% if v_actual.compare_at_price > v_actual.price %}<s>{{ v_actual.compare_at_price | money }}</s>{% endif %}</p>

      {%- assign form_id = 'mn-form-' | append: section.id -%}
      {%- form 'product', product, class: 'mn-form', id: form_id -%}
        <input type="hidden" name="id" value="{{ v_actual.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign oi = forloop.index0 -%}
            {%- assign es_talla = false -%}
            {%- if option.name == 'Size' or option.name == 'Talla' -%}{%- assign es_talla = true -%}{%- endif -%}
            {%- assign es_color = false -%}
            {%- if option.name == 'Color' or option.name == 'Colour' -%}{%- assign es_color = true -%}{%- endif -%}
            <fieldset class="mn-opcion" {% if option.values.size == 1 %}hidden{% endif %}>
              <legend class="mn-etiqueta">
                <span>
                  {%- if es_talla -%}{{ s.etiqueta_talla }}{%- elsif es_color -%}{{ s.etiqueta_color }}{%- else -%}{{ option.name }}{%- endif -%}
                </span>
                {%- if es_talla and s.tabla_tallas != blank -%}<a class="mn-link" href="#mn-guia-{{ section.id }}">{{ s.texto_guia }}</a>{%- endif -%}
              </legend>
              {%- for value in option.values -%}
                {%- assign hex = '' -%}
                {%- if es_color -%}
                  {%- assign vk = value | split: '·' | last | handleize -%}
                  {%- for t in tonos -%}
                    {%- assign par = t | split: ':' -%}
                    {%- assign tk = par[0] | strip -%}
                    {%- if tk == vk -%}{%- assign hex = par[1] | strip -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                <label class="mn-chip">
                  <input type="radio" name="mn-opcion-{{ section.id }}-{{ oi }}" value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}>
                  <span>{%- if hex != blank -%}<i style="--sw: {{ hex }}"></i>{%- endif -%}{{ value }}</span>
                </label>
              {%- endfor -%}
            </fieldset>
          {%- endfor -%}
          <script type="application/json" data-variantes>{{ product.variants | json }}</script>
        {%- endunless -%}
        <button type="submit" name="add" class="mn-btn mn-btn--acento"
          data-anadir="{{ s.boton_texto | escape }}" data-agotado="{{ s.texto_agotado | escape }}" data-no-disponible="{{ s.texto_no_disponible | escape }}"
          {% unless v_actual.available %}disabled{% endunless %}>
          {%- if v_actual.available -%}{{ s.boton_texto }}{%- else -%}{{ s.texto_agotado }}{%- endif -%}
        </button>
        {%- if s.nota != blank -%}<p class="mn-pdp__nota">{{ s.nota | newline_to_br }}</p>{%- endif -%}
      {%- endform -%}

      <div>
        <details class="mn-acordeon mn-hundido" open>
          <summary>{{ s.titulo_descripcion }}</summary>
          <div class="mn-acordeon__cuerpo">{{ product.description }}</div>
        </details>
        {%- if s.tabla_tallas != blank or s.nota_fit != blank -%}
          <details class="mn-acordeon mn-hundido" id="mn-guia-{{ section.id }}">
            <summary>{{ s.texto_guia }}</summary>
            <div class="mn-acordeon__cuerpo">
              {%- if s.nota_fit != blank -%}<p>{{ s.nota_fit | newline_to_br }}</p>{%- endif -%}
              {%- if s.tabla_tallas != blank -%}
                {%- assign filas = s.tabla_tallas | newline_to_br | split: '<br />' -%}
                <table class="mn-tallas">
                  {%- for fila in filas -%}
                    {%- assign primera = forloop.first -%}
                    {%- assign celdas = fila | strip | split: '|' -%}
                    <tr>{%- for c in celdas -%}{%- if primera -%}<th>{{ c | strip }}</th>{%- else -%}<td>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}</tr>
                  {%- endfor -%}
                </table>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
        {%- if s.envios != blank -%}
          <details class="mn-acordeon mn-hundido">
            <summary>{{ s.titulo_envios }}</summary>
            <div class="mn-acordeon__cuerpo"><p>{{ s.envios | newline_to_br }}</p></div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="mn-barra mn-relieve" aria-hidden="true">
    <span><strong>{{ product.title | split: '—' | first | strip }}</strong> · <span data-mn-barra-precio>{{ v_actual.price | money }}</span></span>
    <button type="button" class="mn-btn mn-btn--acento" tabindex="-1">{{ s.boton_texto }}</button>
  </div>
</section>
{%- if s.mostrar_visor -%}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
  <script src="{{ 'mn-viewer.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "MN · Producto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "MORENO.co" },
    { "type": "checkbox", "id": "mostrar_visor", "label": "Mostrar la prenda en 3D (solo prendas con fotos 3D)", "default": false },
    { "type": "range", "id": "max_fotos", "label": "Fotos máximas en la galería", "min": 1, "max": 20, "step": 1, "default": 6 },
    { "type": "textarea", "id": "tonos", "label": "Colores (clave:#color, separados por comas)", "default": "onyx:#323338, ink:#111015, bone:#dfe1f2, stone:#7b7b7d, ash:#95969a, sand:#dbd0c3, espresso:#937663, oxblood:#d51625, midnight:#171b30, dusty-rose:#f689b4, rose:#dc84a6, olive:#6b6a45, cream:#efe6d4, black:#1b1a19" },
    { "type": "header", "content": "Compra" },
    { "type": "text", "id": "etiqueta_talla", "label": "Nombre de la opción de talla", "default": "Talla" },
    { "type": "text", "id": "etiqueta_color", "label": "Nombre de la opción de color", "default": "Color" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Añadir a la bolsa" },
    { "type": "text", "id": "texto_agotado", "label": "Texto si está agotado", "default": "Agotado" },
    { "type": "text", "id": "texto_no_disponible", "label": "Texto si la combinación no existe", "default": "No disponible" },
    { "type": "textarea", "id": "nota", "label": "Nota bajo el botón", "default": "Oversize por diseño: para un ajuste clásico, pide una talla menos." },
    { "type": "header", "content": "Guía de tallas" },
    { "type": "text", "id": "texto_guia", "label": "Título de la guía", "default": "Guía de tallas" },
    { "type": "textarea", "id": "nota_fit", "label": "Nota sobre el corte", "default": "Corte oversize con hombro caído." },
    { "type": "textarea", "id": "tabla_tallas", "label": "Tabla (una fila por línea, columnas separadas por |)", "info": "Ejemplo: Talla | Pecho (cm) | Largo (cm). Déjala vacía si aún no tienes las medidas." },
    { "type": "header", "content": "Acordeones" },
    { "type": "text", "id": "titulo_descripcion", "label": "Título de la descripción", "default": "Descripción" },
    { "type": "text", "id": "titulo_envios", "label": "Título de envíos", "default": "Envíos y cambios" },
    { "type": "textarea", "id": "envios", "label": "Texto de envíos", "default": "Recibirás el número de seguimiento por correo en cuanto salga tu pedido." },
    { "type": "header", "content": "Color y espacio" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#E9E4DC" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#3A332C" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
